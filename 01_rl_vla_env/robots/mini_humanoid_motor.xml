<mujoco model="mini_humanoid_motor">
  <compiler angle="radian"/>
  <option timestep="0.01" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.2" armature="0.03" limited="true"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.02 0.001"/>
    <motor ctrllimited="true" ctrlrange="-12 12"/>
  </default>

  <asset>
    <material name="mat_torso" rgba="0.18 0.32 0.85 1"/>
    <material name="mat_head" rgba="0.24 0.76 0.44 1"/>
    <material name="mat_arm" rgba="0.95 0.55 0.18 1"/>
    <material name="mat_thigh" rgba="0.55 0.58 0.63 1"/>
    <material name="mat_shin" rgba="0.22 0.25 0.30 1"/>
    <material name="mat_left_foot" rgba="0.08 0.46 0.95 1"/>
    <material name="mat_right_foot" rgba="0.95 0.18 0.16 1"/>
    <material name="mat_joint" rgba="0.95 0.08 0.08 1"/>
    <material name="mat_floor" rgba="0.88 0.88 0.86 1"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 -3 4" dir="0 1 -1" diffuse="0.8 0.8 0.8"/>
    <camera name="overview" pos="2.4 -3.2 1.9" xyaxes="0.8 0.6 0 -0.18 0.24 0.95"/>
    <geom name="floor" type="plane" size="3 3 0.1" material="mat_floor"/>

    <!-- Root body. It is fixed in space for now, so we can focus on joint control. -->
    <body name="torso" pos="0 0 1.2">
      <geom name="torso_geom" type="box" size="0.18 0.10 0.32" mass="8.0" material="mat_torso"/>

      <body name="head" pos="0 0 0.52">
        <geom name="head_geom" type="sphere" size="0.13" mass="1.0" material="mat_head"/>
      </body>

      <body name="left_upper_arm" pos="0 0.18 0.22">
        <joint name="left_shoulder_pitch" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
        <geom name="left_shoulder_marker" type="sphere" size="0.055" mass="0.05" material="mat_joint"/>
        <geom name="left_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.04" mass="0.8" material="mat_arm"/>
      </body>

      <body name="right_upper_arm" pos="0 -0.18 0.22">
        <joint name="right_shoulder_pitch" type="hinge" axis="0 1 0" range="-1.6 1.6"/>
        <geom name="right_shoulder_marker" type="sphere" size="0.055" mass="0.05" material="mat_joint"/>
        <geom name="right_upper_arm_geom" type="capsule" fromto="0 0 0 0 0 -0.34" size="0.04" mass="0.8" material="mat_arm"/>
      </body>

      <body name="left_thigh" pos="0 0.075 -0.38">
        <joint name="left_hip_pitch" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom name="left_hip_marker" type="sphere" size="0.06" mass="0.05" material="mat_joint"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.055" mass="1.2" material="mat_thigh"/>

        <body name="left_shin" pos="0 0 -0.42">
          <joint name="left_knee_pitch" type="hinge" axis="0 1 0" range="0 1.8"/>
          <geom name="left_knee_marker" type="sphere" size="0.06" mass="0.05" material="mat_joint"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" mass="0.9" material="mat_shin"/>

          <body name="left_foot" pos="0 0 -0.42">
            <joint name="left_ankle_pitch" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <geom name="left_ankle_marker" type="sphere" size="0.05" mass="0.04" material="mat_joint"/>
            <geom name="left_foot_geom" type="box" pos="0.12 0 -0.035" size="0.20 0.06 0.035" mass="0.45" material="mat_left_foot"/>
          </body>
        </body>
      </body>

      <body name="right_thigh" pos="0 -0.075 -0.38">
        <joint name="right_hip_pitch" type="hinge" axis="0 1 0" range="-1.2 1.2"/>
        <geom name="right_hip_marker" type="sphere" size="0.06" mass="0.05" material="mat_joint"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.42" size="0.055" mass="1.2" material="mat_thigh"/>

        <body name="right_shin" pos="0 0 -0.42">
          <joint name="right_knee_pitch" type="hinge" axis="0 1 0" range="0 1.8"/>
          <geom name="right_knee_marker" type="sphere" size="0.06" mass="0.05" material="mat_joint"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.40" size="0.045" mass="0.9" material="mat_shin"/>

          <body name="right_foot" pos="0 0 -0.42">
            <joint name="right_ankle_pitch" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
            <geom name="right_ankle_marker" type="sphere" size="0.05" mass="0.04" material="mat_joint"/>
            <geom name="right_foot_geom" type="box" pos="0.12 0 -0.035" size="0.20 0.06 0.035" mass="0.45" material="mat_right_foot"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_shoulder_pitch_motor" joint="left_shoulder_pitch"/>
    <motor name="right_shoulder_pitch_motor" joint="right_shoulder_pitch"/>
    <motor name="left_hip_pitch_motor" joint="left_hip_pitch"/>
    <motor name="left_knee_pitch_motor" joint="left_knee_pitch"/>
    <motor name="left_ankle_pitch_motor" joint="left_ankle_pitch"/>
    <motor name="right_hip_pitch_motor" joint="right_hip_pitch"/>
    <motor name="right_knee_pitch_motor" joint="right_knee_pitch"/>
    <motor name="right_ankle_pitch_motor" joint="right_ankle_pitch"/>
  </actuator>
</mujoco>
